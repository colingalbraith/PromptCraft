{
  "manifest_version": 3,
  "name": "PromptCraft",
  "short_name": "PromptCraft",
  "version": "1.1.0",
  "description": "Enhance your AI prompts with OpenAI, Gemini, Claude, or local Ollama models",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab",
    "contextMenus",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "*://*.chatgpt.com/*",
    "*://*.claude.ai/*",
    "*://*.gemini.google.com/*",
    "*://*.deepseek.com/*",
    "*://*.perplexity.ai/*",
    "*://*.grok.com/*",
    "*://*.x.com/*",
    "*://*.huggingface.co/*",
    "*://*.openrouter.ai/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.deepseek.com/*",
        "*://*.gemini.google.com/*",
        "*://*.chatgpt.com/*",
        "*://*.claude.ai/*",
        "*://*.perplexity.ai/*",
        "*://*.grok.com/*",
        "*://*.x.com/i/grok*",
        "*://*.huggingface.co/*",
        "*://*.openrouter.ai/*"
      ],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "commands": {
    "enhance-prompt": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Enhance the prompt in the focused text field"
    }
  },
  "action": {
    "default_title": "Open PromptCraft",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
